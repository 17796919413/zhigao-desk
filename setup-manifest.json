{
  "schemaVersion": 1,
  "name": "zhigao",
  "version": "1.11.0",
  "guide": "./AGENT_SETUP.md",
  "connector": "./zhigao-connector.mjs",
  "connectPage": "./?connect=1",
  "runtime": {
    "name": "node",
    "minimumMajor": 18
  },
  "clients": [
    "claude",
    "codex",
    "workbuddy",
    "dsh",
    "manual"
  ],
  "commands": {
    "inspect": [
      "node",
      "zhigao-connector.mjs",
      "doctor",
      "--json"
    ],
    "configure": [
      "node",
      "zhigao-connector.mjs",
      "setup",
      "--client",
      "<current-client>",
      "--json"
    ],
    "verify": [
      "node",
      "zhigao-connector.mjs",
      "doctor",
      "--verify-feishu",
      "--json"
    ],
    "repair": [
      "node",
      "zhigao-connector.mjs",
      "repair",
      "--json"
    ],
    "mediaInspect": [
      "node",
      "zhigao-connector.mjs",
      "media",
      "doctor",
      "--json"
    ],
    "mediaSetup": [
      "node",
      "zhigao-connector.mjs",
      "media",
      "setup",
      "--json"
    ]
  },
  "mcpTools": {
    "status": "zhigao_setup_status",
    "openExistingSettings": "zhigao_open_setup",
    "videoRuntimeStatus": "zhigao_video_runtime_status",
    "setupVideoRuntime": "zhigao_setup_video_runtime",
    "prepareVideo": "zhigao_prepare_video_review",
    "videoStatus": "zhigao_get_video_review_status",
    "readAsset": "zhigao_read_review_asset",
    "readContext": "zhigao_read_review_context",
    "recordChecks": "zhigao_record_review_checks"
  },
  "runtimeUpgrade": {
    "mode": "authenticated-idle-handoff",
    "legacy": "explicit-confirmed-standalone-restart",
    "clientList": "live-connections-only"
  },
  "feishu": {
    "package": "@larksuite/cli",
    "identity": "user",
    "domains": [
      "sheets",
      "drive",
      "wiki"
    ],
    "login": [
      "lark-cli",
      "auth",
      "login",
      "--domain",
      "sheets",
      "--domain",
      "drive",
      "--domain",
      "wiki",
      "--no-wait",
      "--json"
    ],
    "completeLogin": [
      "lark-cli",
      "auth",
      "login",
      "--device-code",
      "<current-device-code>"
    ],
    "verify": [
      "lark-cli",
      "auth",
      "status",
      "--json",
      "--verify"
    ]
  },
  "archive": {
    "scope": "current-browser-current-project",
    "mode": "browser-directory-picker",
    "userSelectionRequired": true
  },
  "completion": {
    "ai": "page connected and current client can call zhigao_status",
    "feishu": "user login verified; target table access checked separately when supplied",
    "archive": "browser.archive.state is granted",
    "video": "all frames and audio channels prepared; current brand basis, text, images and required audio reviewed; coverage.complete and assurance.complete true; human confirmation remains"
  },
  "autoUpdate": {
    "protocol": 1,
    "sha256": "02040e891ea02cddd52a6a4b32317d4581a899b4020b463f93fcd89a6ac62f06",
    "startup": true,
    "intervalHours": 6,
    "retryMinutes": 15,
    "applyWhen": "idle",
    "launcherScheme": "zhigao-desk"
  },
  "media": {
    "protocol": 1,
    "version": "1.11.0",
    "files": {
      "media-runtime.mjs": {
        "sha256": "3f1be5cad6fb02a19d39cd0b00a2472caa5a6aeab3802b0efcc877d5aa6d6f55",
        "bytes": 14921
      },
      "media-worker.py": {
        "sha256": "182e0fd15d16f0a305db1ec2faf629d045a3330941462be4ecff1d5c78ed34ba",
        "bytes": 19105
      }
    },
    "defaultModel": "large-v3-turbo",
    "installScope": "private-local",
    "semanticReview": "current-connected-agent"
  },
  "review": {
    "protocolVersion": "1.11.0",
    "context": "Read each required brief.context section through nextCursor=null; reconstruct json-fragment records and block slices without truncation.",
    "checkpoint": "record_review_checks saves checks without completing review. Final explicit arrays replace saved arrays.",
    "basisChanges": "BASIS_CHANGED requires retry:true, updates pages and a fresh full review. Previous checks are advisory only.",
    "sourceCache": "Original parsed sources only; project and current source hashes verified; never writes derived policy to brand library."
  }
}
